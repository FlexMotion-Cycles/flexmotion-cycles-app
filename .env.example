POSTGRES_DB=flexmotion
POSTGRES_USER=flexmotion
POSTGRES_PASSWORD=12345
POSTGRES_HOST_PORT=5432

RABBITMQ_USER=flexmotion
RABBITMQ_PASSWORD=12345
RABBITMQ_ENABLED_PLUGINS=rabbitmq_management,rabbitmq_mqtt
RABBITMQ_ENABLED_PLUGINS_FILE=/var/lib/rabbitmq/enabled_plugins
RABBITMQ_MQTT_HOST_PORT=1883
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

MQTT_BROKER_URL=tcp://rabbitmq:1883
MQTT_TOPIC_PREFIX=flexmotion/telemetry
MQTT_COMMAND_TOPIC_PREFIX=flexmotion/commands
MQTT_CONTROL_TOPIC_PREFIX=flexmotion/simulator
MQTT_CLIENT_ID=flexmotion-backend

# Fleet simulator
SIMULATOR_TICK_INTERVAL=5s
SIMULATOR_BATTERY_DRAIN_PER_TICK=1
SIMULATOR_JAVA_OPTS=-Xms64m -Xmx256m
TELEMETRY_ADAPTER=mqtt

BACKEND_PORT=8080
BACKEND_HOST_PORT=8000
SPRING_PROFILES_ACTIVE=default
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}
